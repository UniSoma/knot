{:paths ["src" "resources"]
 ;; All non-bb dependencies (clj-yaml, cheshire, flatland.ordered.map) ship
 ;; bundled with babashka, so no :deps declaration is required at runtime.
 ;; The minimum version below is a conservative floor — it covers the bb
 ;; releases where babashka.cli is present and the bundled dep surface used
 ;; here (ordered-map iteration, clj-yaml ordered preservation) is stable.
 :min-bb-version "1.3.0"

 ;; bbin install metadata. `bbin install <coords> --as knot` reads this
 ;; map and wires up `knot` on PATH to invoke `bb -m knot.main` with the
 ;; project's :paths on the classpath.
 :bbin/bin {knot {:main-opts ["-m" "knot.main"]}}

 :tasks
 {:requires ([babashka.classpath :as cp]
             [babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.string :as str]
             [clojure.test :as t])

  :init
  (defn elpa-package-dir
    "Newest `<pkg>-*` directory under the common system-wide ELPA dirs,
     or nil."
    [pkg]
    (let [home (System/getenv "HOME")]
      (->> ["/usr/share/emacs/site-lisp/elpa"
            "/usr/share/emacs/site-lisp/elpa-src"
            "/usr/local/share/emacs/site-lisp/elpa"
            "/usr/local/share/emacs/site-lisp/elpa-src"
            (when home (str home "/.emacs.d/elpa"))]
           (remove nil?)
           (filter fs/exists?)
           distinct
           (mapcat fs/list-dir)
           (filter (fn [p]
                     (and (fs/directory? p)
                          (str/starts-with? (str (fs/file-name p))
                                            (str pkg "-")))))
           (map str)
           sort
           last)))

  test
  {:doc "Run all tests under test/ (parallel; KNOT_TEST_THREADS overrides worker count)"
   :task
   (do
     (cp/add-classpath "test")
     (cp/add-classpath "script")
     (let [nses (->> (fs/glob "test" "**/*_test.clj")
                     (map (fn [p]
                            {:file (str p)
                             :ns   (-> (str (fs/relativize "test" p))
                                       (str/replace ".clj" "")
                                       (str/replace "/" ".")
                                       (str/replace "\\" ".")
                                       (str/replace "_" "-")
                                       symbol)}))
                     vec)]
       (if (empty? nses)
         (println "No tests found.")
         (do
           (apply require (map :ns nses))
           (require '[knot.test-runner])
           (let [{:keys [fail error]} ((resolve 'knot.test-runner/run-tests) nses)]
             (when (pos? (+ fail error))
               (System/exit 1)))))))}

  knot
  {:doc "Run the knot CLI"
   :task (do
           (require '[knot.main])
           (apply (resolve 'knot.main/-main) *command-line-args*))}

  build:release
  {:doc "Build release binaries into dist/ (--target all|host|<os>-<arch>, default all)"
   :task
   (do
     (cp/add-classpath "script")
     (require '[knot.build])
     (apply (resolve 'knot.build/-main) *command-line-args*))}

  build:jolt
  {:doc "Compile a standalone knot binary with jolt (writes jolt/knot)"
   :task (p/shell {:dir "jolt"} "jolt" "build" "--opt" "--tree-shake" "-m" "knot.main" "-o" "knot")}

  gen:schema
  {:doc "Regenerate knot.schema.json from the current `knot info` allowed values"
   :task
   (do
     (require '[knot.cli] '[knot.config] '[knot.ticket])
     (let [cwd        (str (fs/cwd))
           discovered ((resolve 'knot.config/discover) cwd)]
       (when-not discovered
         (binding [*out* *err*]
           (println (str "gen:schema: no project found at or above " cwd)))
         (System/exit 1))
       (let [root  (:project-root discovered)
             cfg   (:config discovered)
             ctx   (merge cfg
                          {:project-root    root
                           :cwd             cwd
                           :prefix          (or (:prefix cfg)
                                                ((resolve 'knot.ticket/derive-prefix)
                                                 (str (fs/file-name root))))
                           :config-present? (fs/exists?
                                             (fs/path root ".knot.edn"))
                           :project-found?  true})
             out   ((resolve 'knot.cli/schema-cmd) ctx)
             path  (str (fs/path root "knot.schema.json"))]
         (spit path out)
         (println (str "Wrote " path)))))}

  lint:elisp
  {:doc "Byte-compile emacs/knot.el and run package-lint when available"
   :task
   (let [src      "emacs/knot.el"
         helper   "emacs/knot-lint.el"
         emacs    (or (System/getenv "EMACS") "emacs")
         shell    (fn [& args]
                    (:exit (apply p/shell {:continue true} args)))]
     (when-not (fs/exists? src)
       (binding [*out* *err*]
         (println (str "lint:elisp: " src " not found")))
       (System/exit 1))
     ;; Locate optional dependencies under common system-wide ELPA
     ;; directories.  package-lint is treated as optional per the
     ;; slice-1 acceptance ("when available").  markdown-mode is a
     ;; Package-Requires dep and must be on the load-path for
     ;; byte-compile to succeed.
     (let [md-mode   (elpa-package-dir "markdown-mode")
           pkg-lint  (elpa-package-dir "package-lint")
           load-paths (cond-> []
                        md-mode  (conj "-L" md-mode)
                        pkg-lint (conj "-L" pkg-lint))]
       (when-not md-mode
         (binding [*out* *err*]
           (println "lint:elisp: markdown-mode not found under any ELPA dir;"
                    "byte-compile may fail")))
       (println "lint:elisp: byte-compiling" src)
       (let [bc-exit (apply shell
                            emacs "-batch" "-Q"
                            (concat load-paths
                                    ["-l" helper
                                     "-f" "knot-lint-batch-byte-compile"
                                     src]))]
         (when-not (zero? bc-exit)
           (System/exit bc-exit)))
       (if pkg-lint
         (let [_ (println "lint:elisp: running package-lint")
               pl-exit (apply shell
                              emacs "-batch" "-Q"
                              (concat load-paths
                                      ["-l" helper
                                       "-f" "knot-lint-batch-package-lint"
                                       src]))]
           (when-not (zero? pl-exit)
             (System/exit pl-exit)))
         (println "lint:elisp: package-lint not found; skipping"))))}

  test:elisp
  {:doc "Run the ERT suite in emacs/knot-test.el"
   :task
   (let [md-mode (elpa-package-dir "markdown-mode")]
     (when-not md-mode
       (binding [*out* *err*]
         (println "test:elisp: markdown-mode not found under any ELPA dir;"
                  "loading knot.el may fail")))
     ;; load-prefer-newer: a stale knot.elc left by lint:elisp would
     ;; otherwise shadow the source under test.
     (System/exit
      (:exit (apply p/shell {:continue true}
                    (or (System/getenv "EMACS") "emacs") "-batch" "-Q"
                    "--eval" "(setq load-prefer-newer t)"
                    (concat (when md-mode ["-L" md-mode])
                            ["-L" "emacs"
                             "-l" "emacs/knot-test.el"
                             "-f" "ert-run-tests-batch-and-exit"])))))}}}
